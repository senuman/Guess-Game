    "graphql": "^16.8.1",
    "knex": "^3.0.1",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "bullmq": "^4.14.0",
    "ws": "^8.14.2",
    "axios": "^1.6.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "meyda": "^5.6.2",
    "wavesurfer.js": "^7.5.2",
    "music-metadata": "^8.1.4",
    "openai": "^4.20.1",
    "langchain": "^0.0.201",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "dayjs": "^1.11.10",
    "p-queue": "^7.4.1",
    "sharp": "^0.33.0",
    "tesseract.js": "^5.0.3",
    "natural": "^6.10.0",
    "compromise": "^14.10.0",
    "ml-matrix": "^6.10.5",
    "simple-statistics": "^7.8.3",
    "fft.js": "^4.0.4",
    "dsp.js": "^1.0.0"
