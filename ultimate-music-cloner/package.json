{
  "name": "ultimate-music-cloner",
  "version": "1.0.0",
  "description": "Advanced AI Music Cloning System with 99% similarity achievement",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
